{
  "name": "notion-iconsax",
  "version": "1.0.0",
  "description": "Notion icons",
  "private": true,
  "scripts": {
    "build": "npm run build.client",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "icons": "npx svgr --out-dir ./src/icons ./icons && prettier ./src/icons/*.tsx --write",
    "lint": "eslint \"src/**/*.ts*\"",
    "prebuild": "npm run icons",
    "prebuild.pandacss": "panda codegen --silent",
    "prepare": "panda codegen && npm run icons",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.19.2",
    "@builder.io/qwik-city": "1.19.2",
    "@builder.io/vite-plugin-macro": "~0.0.7",
    "@fullstacksjs/toolbox": "4.22.0",
    "@pandacss/dev": "^1.10.0",
    "@svgr/cli": "8.1.0",
    "@types/eslint": "9.6.1",
    "@types/node": "25.6.0",
    "eslint": "9",
    "eslint-plugin-qwik": "1.19.2",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "undici": "8.1.0",
    "vite": "7",
    "vite-tsconfig-paths": "6.1.1"
  }
}
